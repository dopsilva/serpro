-- serpro — cliente das APIs Consulta CPF e Consulta CNPJ do Serpro
--
--   local serpro = require("serpro")
--   local c = serpro.new({key = "consumer-key", secret = "consumer-secret"})
--   local pessoa = c:cpf("123.456.789-09")        → {ni, nome, situacao = {codigo, descricao}, ...}
--   local empresa = c:cnpj("00.000.000/0001-91")  → os dados básicos (v2/basica)
--   local qsa = c:cnpj("00000000000191", "qsa")   → "basica" (padrão), "qsa" ou "empresa"
--
-- Falhas (rede, 401, 404, 429, CPF/CNPJ inválido) voltam como valor de erro
-- (is_error(v), v.message); use `?` para repassar. O token OAuth2
-- (client_credentials) é pedido sozinho e guardado até perto de expirar.
--
-- opts de serpro.new:
--   key, secret   consumer key e secret do contrato (ou token, um bearer já pronto)
--   trial         true: os serviços de demonstração (-trial), com dados fictícios
--   base_url      padrão "https://gateway.apiserpro.serpro.gov.br"
--   token_url     padrão base_url .. "/token"
--   cpf_path      padrão "/consulta-cpf-df/v1/cpf" ("-trial" com trial)
--   cnpj_path     padrão "/consulta-cnpj-df/v2" ("-trial" com trial)
--   timeout       em ms (padrão 30000)
--
-- Sem a caixa dos paths certa para o seu contrato (o Serpro tem mais de um
-- gateway), troque base_url / token_url / cpf_path / cnpj_path.

local http = require("http")

local M = {}

local DEFAULT_BASE = "https://gateway.apiserpro.serpro.gov.br"

-- ---- CPF / CNPJ: máscara e dígitos verificadores ----

-- only the digits of a CPF
function M.digits(s)
    return re.gsub("[^0-9]", tostring(s or ""), "")
end

-- CPF without mask (11 digits), or nil
function M.clean_cpf(s)
    local d = M.digits(s)
    if len(d) ~= 11 then return nil end
    return d
end

-- CNPJ without mask: 14 characters, digits or (since 2026) A-Z letters, upper-cased; or nil
function M.clean_cnpj(s)
    local d = string.upper(re.gsub("[\\.\\-/\\s]", tostring(s or ""), ""))
    if not re.test("^[0-9A-Z]{12}[0-9]{2}$", d) then return nil end
    return d
end

function M.valid_cpf(s)
    local d = M.clean_cpf(s)
    if d == nil then return false end
    if d == string.rep(string.sub(d, 1, 1), 11) then return false end
    for n = 9, 10 do
        local sum = 0
        for i = 1, n do
            sum += tonumber(string.sub(d, i, i)) * (n + 2 - i)
        end
        local dv = (sum * 10) % 11
        if dv == 10 then dv = 0 end
        if dv ~= tonumber(string.sub(d, n + 1, n + 1)) then return false end
    end
    return true
end

-- the check digit of the first n characters of a CNPJ (value of a character = byte - 48)
local function cnpj_dv(d, n)
    local sum = 0
    local weight = 2
    for i = n, 1, -1 do
        sum += (string.byte(d, i) - 48) * weight
        weight += 1
        if weight > 9 then weight = 2 end
    end
    local r = sum % 11
    if r < 2 then return 0 end
    return 11 - r
end

function M.valid_cnpj(s)
    local d = M.clean_cnpj(s)
    if d == nil then return false end
    if d == string.rep(string.sub(d, 1, 1), 14) then return false end
    if cnpj_dv(d, 12) ~= tonumber(string.sub(d, 13, 13)) then return false end
    if cnpj_dv(d, 13) ~= tonumber(string.sub(d, 14, 14)) then return false end
    return true
end

-- ---- cliente ----

local function now_s()
    return time.now():unix()
end

local function describe(resp)
    local msg = nil
    local body = resp:json()
    if not is_error(body) and type(body) ~= "nil" and type(body) ~= "string" then
        msg = body.mensagem or body.message or body.error_description or body.error
    end
    if msg == nil then msg = resp.reason end
    return `serpro: HTTP ${resp.status}: ${msg}`
end

function M.new(opts)
    opts = opts or {}
    local c = {}
    local base = opts.base_url or DEFAULT_BASE
    local suffix = opts.trial and "-trial" or ""
    local token_url = opts.token_url or (base .. "/token")
    local cpf_path = opts.cpf_path or ("/consulta-cpf-df" .. suffix .. "/v1/cpf")
    local cnpj_path = opts.cnpj_path or ("/consulta-cnpj-df" .. suffix .. "/v2")
    local timeout = opts.timeout or 30000
    local token = opts.token
    local expires = 0
    if token ~= nil then expires = nil end   -- a fixed token never expires here

    -- a valid bearer token, asking for a new one when needed
    function c:token()
        if token ~= nil and (expires == nil or now_s() < expires - 30) then return token end
        if opts.key == nil or opts.secret == nil then
            return error("serpro: informe key e secret (ou token)")
        end
        local basic = encoding.base64_encode(opts.key .. ":" .. opts.secret)
        local resp = http.post(token_url, nil, nil, {
            headers = {Authorization = "Basic " .. basic},
            form = {grant_type = "client_credentials"},
            timeout = timeout,
        })
        if resp.status == 0 then return error("serpro: token: " .. tostring(resp.error)) end
        if not resp.ok then return error("serpro: token: " .. describe(resp)) end
        local body = resp:json()
        if is_error(body) or body.access_token == nil then
            return error("serpro: token: resposta sem access_token")
        end
        token = body.access_token
        expires = now_s() + (tonumber(body.expires_in) or 3600)
        return token
    end

    function c:get(path)
        self:token()?
        for attempt = 1, 2 do
            local resp = http.get(base .. path, {
                headers = {Authorization = "Bearer " .. token, Accept = "application/json"},
                timeout = timeout,
            })
            if resp.status == 0 then return error("serpro: " .. tostring(resp.error)) end
            -- an expired token: forget it and try once more with a new one
            if resp.status == 401 and attempt == 1 and opts.key ~= nil then
                token = nil
                expires = 0
                self:token()?
            else
                if not resp.ok then return error(describe(resp)) end
                local body = resp:json()
                if is_error(body) then return error("serpro: resposta inválida: " .. body.message) end
                return body
            end
        end
        return error("serpro: não autorizado")
    end

    -- the CPF's registration data
    function c:cpf(cpf)
        if not M.valid_cpf(cpf) then return error("serpro: CPF inválido: " .. tostring(cpf)) end
        return self:get(cpf_path .. "/" .. M.clean_cpf(cpf))
    end

    -- the company's data: kind is "basica" (default), "qsa" or "empresa"
    function c:cnpj(cnpj, kind)
        kind = kind or "basica"
        if kind ~= "basica" and kind ~= "qsa" and kind ~= "empresa" then
            return error("serpro: tipo de consulta inválido: " .. tostring(kind))
        end
        if not M.valid_cnpj(cnpj) then return error("serpro: CNPJ inválido: " .. tostring(cnpj)) end
        return self:get(cnpj_path .. "/" .. kind .. "/" .. M.clean_cnpj(cnpj))
    end

    return c
end

return M
